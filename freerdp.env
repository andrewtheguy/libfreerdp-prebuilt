# The one place the versions live. Read by source.sh, build.sh, sync-prebuilt.sh,
# check-static.sh and crates/freerdp-prebuilt-sys/build.rs, so the shell half and the
# Rust half of this repository cannot disagree about what was built.

# ---------------------------------------------------------------- FreeRDP

FREERDP_VERSION=3.30.0

# A *tarball* checksum, unlike libvpx-prebuilt's commit pin — and that is an upgrade
# rather than a difference of taste. libvpx publishes no tarballs at all, so a commit
# was the only stable thing to point at. FreeRDP publishes a real release artifact per
# tag, signed, with the checksum beside it:
#
#   https://github.com/FreeRDP/FreeRDP/releases/download/3.30.0/freerdp-3.30.0.tar.gz
#   …/freerdp-3.30.0.tar.gz.sha256   <- this value, verified on 2026-08-04
#
# Upstream publishes a detached `.asc` beside it too. source.sh does not check it — the
# checksum below is the whole of what gates the build — so there is no keyring to arrange
# and no signature verification to look for in these scripts.
#
# So the pin covers the exact bytes that get compiled, needs no clone, and cannot be
# moved by a retagged branch.
FREERDP_SHA256=e2687d02dea6fede004d36391dac1a74ce57a210f8867fd95033171d4909590c
FREERDP_URL=https://github.com/FreeRDP/FreeRDP/releases/download/${FREERDP_VERSION}/freerdp-${FREERDP_VERSION}.tar.gz

# The commit the tag resolved to when this was pinned. Not what gates the build — the
# checksum above is — but recorded so a reader can find the source in git, and so a
# future bump can be diffed against something.
FREERDP_COMMIT=6b107f0aadbabc47941c5a5b893b88c01792af6d

# ---------------------------------------------------------------- OpenSSL

# FreeRDP requires OpenSSL and will not build without it
# (CMakeLists.txt: `set(OPENSSL_FEATURE_TYPE "REQUIRED")`), so this repository builds
# one rather than letting every consumer find whatever the machine happens to have.
# That is not a hypothetical: configuring against an unset OPENSSL_ROOT_DIR on the
# machine this was written on silently selected Homebrew's OpenSSL 3.6.3 and built
# happily against it.
#
# 3.5.x is the current LTS line. Verified against openssl.org's published .sha256.
OPENSSL_VERSION=3.5.7
OPENSSL_SHA256=a8c0d28a529ca480f9f36cf5792e2cd21984552a3c8e4aa11a24aa31aeac98e8
OPENSSL_URL=https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz

# ---------------------------------------------------------------- publishing

# Where the built archives are published. Read by sync-prebuilt.sh and by
# crates/freerdp-prebuilt-sys/build.rs, so a fork changes this in one place.
PREBUILT_REPO=andrewtheguy/libfreerdp-prebuilt

# The minimum macOS the archives may be linked into. Named here rather than left to
# the builder's own OS version, which is what an unset deployment target inherits —
# an archive built on macOS 26 records `minos 26.0` and cannot be linked into
# anything older. build.sh reads this back off the finished archive and asserts it.
MACOS_DEPLOYMENT_TARGET=11.0
